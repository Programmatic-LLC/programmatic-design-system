{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		"declaration": true,
		"declarationMap": false,
		"sourceMap": false,
		"outDir": "dist",
		"rootDir": "src",
		"types": []
	},
	"include": ["src"],
	"exclude": [
		"src/**/*.stories.tsx",
		"src/**/*.stories.ts",
		"src/**/*.test.tsx",
		"src/**/*.test.ts",
		"src/**/__tests__/**"
	]
}
