{
	"name": "programmatic-design-system",
	"version": "1.0.1",
	"description": "DestinationHub design system: atoms, components, layouts, and templates shared across Programmatic applications",
	"main": "dist/index.js",
	"module": "dist/index.js",
	"types": "dist/index.d.ts",
	"sideEffects": true,
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json && mkdir -p dist/styles && cp src/styles/*.css dist/styles/",
		"prepare": "npm run build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:coverage": "vitest run --coverage",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"repository": {
		"type": "git",
		"url": "git+ssh://git@github.com/Programmatic-LLC/programmatic-design-system.git"
	},
	"license": "UNLICENSED",
	"engines": {
		"node": ">=18"
	},
	"peerDependencies": {
		"@photo-sphere-viewer/core": "^5.0.0",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.0.0",
		"lucide-react": ">=0.400.0",
		"motion": "^12.0.0",
		"react": "^18.0.0 || ^19.0.0",
		"react-dom": "^18.0.0 || ^19.0.0",
		"tailwind-merge": "^3.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^9.22.0",
		"@photo-sphere-viewer/core": "^5.14.3",
		"@storybook/addon-a11y": "^10.4.4",
		"@storybook/addon-docs": "^10.4.4",
		"@storybook/react": "^10.4.4",
		"@storybook/react-vite": "^10.4.4",
		"@tailwindcss/vite": "^4.1.12",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/react": "^16.2.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "^4.3.4",
		"@vitest/coverage-v8": "^3.0.5",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"eslint": "^9.22.0",
		"eslint-plugin-react": "^7.37.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^15.15.0",
		"jsdom": "^26.0.0",
		"lucide-react": "0.487.0",
		"motion": "12.23.24",
