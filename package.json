		"storybook": "^10.4.4",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.1.12",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.26.0",
		"vite": "^7.0.0",
		"vitest": "^3.0.5"
	}
